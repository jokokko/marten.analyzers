<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008: no release tracking. RS1032: messages end with a period. -->
    <NoWarn>$(NoWarn);RS2008;RS1032</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
	<NuspecProperties>configuration=$(Configuration);version=$(Version)</NuspecProperties>
	<NuspecFile>Marten.Analyzers.nuspec</NuspecFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lowest Roslyn supported: 4.12 of .NET SDK 9, the oldest to build Marten 9. A newer one does not load into older compilers. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
